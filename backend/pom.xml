<?xml version="1.0" encoding="UTF-8"?>
<!-- =====================================================================
     产品质量追踪系统 · 后端 Maven 构建文件
     =====================================================================
     版本矩阵（2026-07-04 经官方渠道调研锁定，禁止漂移，依据见 docs/01-需求分析.md §6）：
       Spring Boot 3.5.16（3.x 最终形态；4.x 生态未熟不用）
       MyBatis-Plus  3.5.16（boot3 专用 starter + jsqlparser 分页扩展，两者版本必须严格一致）
       Druid         1.2.28（boot3 专用 starter；只开 stat 不开 wall——wall 对递归 CTE 有解析风险）
       jjwt          0.13.0（0.12+ 新链式 API）
       springdoc     2.8.17（Boot 3.5 对应线；Boot 不托管其版本，必须显式声明）
       hutool        5.8.46（修复 JNDIUtil 漏洞的版本，勿降级）
       其余（mysql-connector-j 9.7.0 / spring-security-crypto 6.5.11 / Lombok 1.18.46 /
             HikariCP 备选）由 Boot 3.5.16 依赖管理托管，不手写版本号。
     编译目标：字节码锁定 Java 21（LTS）；本机以 JDK 25 交叉编译（release=21），
               JDK 21~25 环境均可构建与运行。
     ===================================================================== -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方 parent：统一管理依赖版本与插件默认配置 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.xinghui</groupId>
    <artifactId>quality-trace</artifactId>
    <version>1.0.0</version>
    <name>quality-trace</name>
    <description>基于 SpringBoot 的产品质量追踪系统（数据库课程设计）</description>

    <properties>
        <!-- 字节码目标版本：Java 21 LTS（maven-compiler-plugin 的 release 参数由此推导） -->
        <java.version>21</java.version>
        <!-- 统一第三方组件版本：集中声明便于审查与升级 -->
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <druid.version>1.2.28</druid.version>
        <jjwt.version>0.13.0</jjwt.version>
        <springdoc.version>2.8.17</springdoc.version>
        <hutool.version>5.8.46</hutool.version>
    </properties>

    <dependencies>
        <!-- ===== Web 层：Spring MVC + 内嵌 Tomcat ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ===== 参数校验：JSR-380（@NotNull/@NotBlank/@Positive 等注解 + @Validated 触发） =====
             防御编程要求：所有外部输入必须在服务端校验，前端校验仅为体验优化 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===== ORM：MyBatis-Plus（Boot 3 必须用 spring-boot3 后缀的 starter，
             用错 mybatis-plus-boot-starter 会报 factoryBeanObjectType 装配错误） ===== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- MyBatis-Plus 3.5.9+ 将分页能力拆分至独立模块：
             不引入此件则 PaginationInnerInterceptor 缺失，分页静默失效（返回全量且 total=0） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- ===== 数据库驱动：新坐标 com.mysql（老坐标 mysql:mysql-connector-java 已停更），
             版本由 Boot 3.5.16 托管 = 9.7.0，与 MySQL 8.4 服务端兼容 ===== -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== 连接池：Druid（Boot 3 专用 starter）。
             选型理由：内置 /druid 监控台（SQL 统计、慢 SQL 定位），与数据库课程主题强相关；
             配置纪律：只开 stat 过滤器、绝不开 wall（防火墙对 WITH RECURSIVE 的解析失败
             会直接拒绝执行 SQL，而本系统追溯功能完全依赖递归 CTE） ===== -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
            <version>${druid.version}</version>
        </dependency>

        <!-- ===== JWT：jjwt 三件套（api 编译期 / impl+jackson 运行期）。
             0.12+ 链式 API：Jwts.builder().subject()... / Jwts.parser().verifyWith()...
             注意：网上 0.11.x 老教程（parserBuilder/setSubject）在本版本编译不过 ===== -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== 密码哈希：单独引入 spring-security-crypto 获得 BCryptPasswordEncoder，
             不引 spring-boot-starter-security（避免整条过滤器链，认证由自实现 JWT 拦截器负责，
             链路透明、答辩可逐行讲解）。版本由 Boot 托管 = 6.5.11 ===== -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- ===== 接口文档：springdoc（OpenAPI 3.1 + swagger-ui）。
             调研否决了 Knife4j（4.5.0 停更 2.5 年，配 Boot 3.5 开箱抛 NoSuchMethodError）；
             Boot 不托管 springdoc 版本，必须显式写；勿误引 3.0.x（Boot 4 专用线） ===== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ===== 工具库：hutool（中文文档丰富；ExcelUtil 支撑报表导出）。
             5.8.46 修复了 JNDIUtil 远程加载漏洞，锁定此 patch ===== -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>

        <!-- ===== Lombok：编译期生成 getter/setter/builder，版本由 Boot 托管 = 1.18.46 ===== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>quality-trace</finalName>
        <plugins>
            <!-- 编译插件：release=21 交叉编译（本机 JDK 25 → 21 字节码）。
                 关键坑：JDK 23+ 的 javac 默认 -proc:none 不再自动运行注解处理器，
                 必须用 annotationProcessorPaths 显式声明 Lombok，否则全量 cannot find symbol -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Boot 打包插件：生成可执行 fat-jar；Lombok 为编译期依赖，从产物中剔除 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
